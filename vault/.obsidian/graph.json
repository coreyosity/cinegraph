  "collapse-display": true,
  "showArrow": false,
  "textFadeMultiplier": -0.7,
  "nodeSizeMultiplier": 0.9,
  "lineSizeMultiplier": 1,
  "collapse-forces": true,
  "centerStrength": 0.35,
  "repelStrength": 12,
