# secrets
.env

# AI planning / working docs (local only)
.ai/

# stray Obsidian config at the repo root (the real vault config is vault/.obsidian/)
/.obsidian/

# python
__pycache__/
*.pyc
.venv/
venv/

# --- vault: track inputs, ignore generated content ---
# Films/ and Watchlist/ ARE tracked: they hold irreplaceable data (Letterboxd ratings +
# expensive-to-refetch TMDB metadata). Everything below is a pure derived artifact,
# rebuilt by gen_entities.py (local, instant) or discover.py (needs a TMDB key).
vault/People/
vault/Studios/
vault/Genres/
vault/Themes/
# keep persistent user dismissals (survives discover.py reruns); ignore the rest of Discover/
vault/Discover/*
!vault/Discover/_dismissed/
# Obsidian-only working data (logs, caches, match logs); publish-excluded. _bases/ IS tracked.
vault/_meta/

# sample fixtures: same split — generated entity dirs are regenerated by the scripts
sample/People/
sample/Studios/
sample/Genres/

# node / quartz build output + caches
node_modules/
public/
.quartz-cache/
.DS_Store

# upstream Quartz's own docs — vendored in the engine clone but irrelevant to cinegraph
# (the site builds from site/content -> vault, not docs/). See site/UPSTREAM.md.
site/docs/

# generated data indexes baked by gen_index.py (rebuilt each run; not source)
site/quartz/static/films.json
site/quartz/static/discover.json
site/quartz/static/watchlist.json
